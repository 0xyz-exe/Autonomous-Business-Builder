# Local dev (no Postgres): SQLite file in backend/
DATABASE_URL=sqlite+aiosqlite:///./business_builder.db

# Production / Docker: PostgreSQL
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/business_builder

# OpenAI — set to "mock" for demo data without API calls
OPENAI_API_KEY=mock
OPENAI_MODEL=gpt-4o-mini

APP_ENV=development
FRONTEND_URL=http://localhost:3000
